{
  "name": "virtual-code-agent",
  "version": "0.2.0",
  "description": "Virtual Code Agent - LangGraph.js 驱动的编码 Agent（TS 重写版）",
  "type": "module",
  "bin": {
    "vca": "./dist/main.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "server": "tsx src/server.ts",
    "web:dev": "cd web && npm run dev",
    "build": "tsc",
    "build:web": "cd web && npm install && npm run build",
    "start": "node dist/main.js",
    "serve": "tsc && node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/vsce": "^3.9.2",
    "js-yaml": "^5.2.3",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
