{
  "name": "vca-coding-agent",
  "displayName": "VCA Coding Agent",
  "description": "Virtual Code Agent - LangGraph.js 驱动的编码 Agent，在 IDE 内直接对话完成任务",
  "version": "0.1.0",
  "publisher": "vca",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vca-sidebar",
          "title": "VCA Coding Agent",
          "icon": "media/vca.svg"
        }
      ]
    },
    "views": {
      "vca-sidebar": [
        {
          "type": "webview",
          "id": "vca.chatView",
          "name": "聊天",
          "icon": "media/vca.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "vca.openChat",
        "title": "VCA: 打开 Coding Agent 聊天面板",
        "category": "VCA"
      },
      {
        "command": "vca.sendSelection",
        "title": "VCA: 发送选中代码到 Agent",
        "category": "VCA"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vca.openChat",
          "when": "workspaceFolderCount >= 0"
        },
        {
          "command": "vca.sendSelection",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "vca.openChat",
          "when": "view == vca.chatView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "vca.sendSelection",
          "when": "editorHasSelection",
          "group": "VCA@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node ../scripts/build-extension.mjs",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
